{
  "name": "freepls-indonesia",
  "version": "1.0.0",
  "description": "FreePLS Indonesia - Open Source PLS-SEM Desktop Software for Research & Education",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "mcp": "node mcp-server/index.js",
    "mcp:test": "node mcp-server/test-mcp.js"
  },
  "keywords": ["freepls", "pls-sem", "sem-pls", "statistik", "penelitian", "open-science"],
  "author": "FreePLS Indonesia Contributors",
  "license": "CC-BY-NC-4.0",
  "type": "commonjs",
  "build": {
    "appId": "org.freepls.indonesia",
    "productName": "FreePLS Indonesia",
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "assets/**/*",
      "mcp-server/**/*",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "node_modules/sql.js/**/*",
      "node_modules/xlsx/**/*",
      "src/pls-engine.js"
    ],
    "extraResources": [
      {
        "from": "node_modules/sql.js/dist/sql-wasm.wasm",
        "to": "sql-wasm.wasm"
      },
      {
        "from": "mcp-server",
        "to": "mcp-server"
      }
    ]
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "sql.js": "^1.10.0",
    "xlsx": "^0.18.5",
    "csv-parse": "^5.5.3"
  }
}
