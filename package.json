{
  "name": "openpls-indonesia",
  "version": "1.0.0",
  "description": "OpenPLS Indonesia - Open Source PLS-SEM Desktop Software for Research & Education",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "keywords": ["openpls", "pls-sem", "sem-pls", "statistik", "penelitian", "open-science"],
  "author": "OpenPLS Indonesia Contributors",
  "license": "CC-BY-NC-4.0",
  "type": "commonjs",
  "build": {
    "appId": "org.openpls.indonesia",
    "productName": "OpenPLS Indonesia",
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "assets/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "node_modules/sql.js/dist/sql-wasm.wasm",
        "to": "sql-wasm.wasm"
      }
    ]
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "sql.js": "^1.10.0",
    "xlsx": "^0.18.5",
    "csv-parse": "^5.5.3"
  }
}
